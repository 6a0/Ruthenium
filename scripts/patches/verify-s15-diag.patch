@@ -0,0 +1,58 @@
+package net.ruthenium.render.entity;
+
+import net.minecraft.world.entity.Entity;
+import net.ruthenium.Initializer;
+
+/** Throwaway verification counters (verify/s15-diag branch only) */
+public final class VerifyCounters {
+    public static long lightHits, lightMisses, lightMismatches;
+    public static long cullDecided, cullUndecided, cullMismatches;
+    private static long nextLightLog = 1_000_000, nextCullLog = 1_000_000;
+    private static int lightReports, cullReports;
+
+    private VerifyCounters() {
+    }
+
+    public static void light(Entity entity, Object layer, long pos, int kept, int fresh) {
+        lightHits++;
+        if (kept != fresh) {
+            lightMismatches++;
+            if (lightReports++ < 30) {
+                Initializer.LOGGER.warn("VERIFY light mismatch {} {} at {} kept {} fresh {} gen {}", entity.getType(), layer,
+                        net.minecraft.core.BlockPos.of(pos), kept, fresh, EntityLight.generation());
+            }
+        }
+        if (lightHits >= nextLightLog) {
+            nextLightLog += 1_000_000;
+            logLight();
+        }
+    }
+
+    public static void logLight() {
+        Initializer.LOGGER.info("VERIFY light: hits {} misses {} mismatches {} gen {}", lightHits, lightMisses, lightMismatches,
+                EntityLight.generation());
+    }
+
+    public static void cull(Entity entity, int fast, boolean vanilla) {
+        if (fast < 0) {
+            cullUndecided++;
+            return;
+        }
+        cullDecided++;
+        if ((fast == 1) != vanilla) {
+            cullMismatches++;
+            if (cullReports++ < 30) {
+                Initializer.LOGGER.warn("VERIFY cull mismatch {} fast {} vanilla {} box {}", entity.getType(), fast, vanilla,
+                        entity.getBoundingBox());
+            }
+        }
+        if (cullDecided >= nextCullLog) {
+            nextCullLog += 1_000_000;
+            logCull();
+        }
+    }
+
+    public static void logCull() {
+        Initializer.LOGGER.info("VERIFY cull: decided {} undecided {} mismatches {}", cullDecided, cullUndecided, cullMismatches);
+    }
+}
