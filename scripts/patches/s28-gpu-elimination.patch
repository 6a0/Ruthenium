diff --git a/src/main/java/net/ruthenium/render/S28Counters.java b/src/main/java/net/ruthenium/render/S28Counters.java
new file mode 100644
index 0000000..8e6f92d
--- /dev/null
+++ b/src/main/java/net/ruthenium/render/S28Counters.java
@@ -0,0 +1,39 @@
+package net.ruthenium.render;
+
+import java.util.Map;
+import java.util.TreeMap;
+
+/** TEMPORARY (s28): quads and draws per category, logged every 8192 frames when -Druthenium.s28.counters=true */
+public final class S28Counters {
+    public static final boolean ENABLED = Boolean.getBoolean("ruthenium.s28.counters");
+    private static final Map<String, long[]> COUNTS = new TreeMap<>();
+    private static int frames;
+
+    private S28Counters() {
+    }
+
+    public static void add(String key, long quads, long instances) {
+        if (!ENABLED) {
+            return;
+        }
+        long[] c = COUNTS.computeIfAbsent(key, k -> new long[3]);
+        c[0] += quads;
+        c[1] += instances;
+        c[2]++;
+    }
+
+    public static void endFrame() {
+        if (!ENABLED || ++frames < 8192) {
+            return;
+        }
+        StringBuilder sb = new StringBuilder("s28 counters per frame:");
+        for (Map.Entry<String, long[]> e : COUNTS.entrySet()) {
+            long[] c = e.getValue();
+            sb.append("\n  ").append(e.getKey()).append(": quads ").append(c[0] / frames).append(", instances ")
+                    .append(c[1] / frames).append(", draws ").append(c[2] / frames);
+        }
+        net.ruthenium.Initializer.LOGGER.info(sb.toString());
+        COUNTS.clear();
+        frames = 0;
+    }
+}
