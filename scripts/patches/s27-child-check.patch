+package net.ruthenium.render.entity;
+
+import net.minecraft.client.model.geom.ModelPart;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.Map;
+
+/** Temporary check of partChildArrays: the array against the children map's iteration, per render (-Druthenium.childCheck=true) */
+public final class ChildArrayCheck {
+    public static final boolean ENABLED = Boolean.getBoolean("ruthenium.childCheck");
+    private static final Logger LOGGER = LoggerFactory.getLogger("Ruthenium child check");
+    private static long renders, children, mismatches, leaves;
+
+    private ChildArrayCheck() {
+    }
+
+    private static long fallbacks;
+
+    public static synchronized void fallback() {
+        if (++fallbacks % 1000 == 1) {
+            LOGGER.info("child arrays: {} fallbacks to the map", fallbacks);
+        }
+    }
+
+    public static synchronized void check(ModelPart[] array, Map<String, ModelPart> map) {
+        renders++;
+        if (array.length == 0) {
+            leaves++;
+        }
+        int i = 0;
+        for (ModelPart child : map.values()) {
+            if (i >= array.length || array[i] != child) {
+                mismatches++;
+            }
+            i++;
+            children++;
+        }
+        if (i != array.length) {
+            mismatches++;
+        }
+        if (renders % 5_000_000 == 0) {
+            LOGGER.info("child arrays: {} renders ({} leaves), {} children compared, {} mismatches, {} fallbacks", renders, leaves, children, mismatches, fallbacks);
+        }
+    }
+}
