+package net.ruthenium.render.vertex;
+
+import com.google.common.primitives.Floats;
+import com.mojang.blaze3d.vertex.CompactVectorArray;
+import com.mojang.blaze3d.vertex.VertexSorting;
+import it.unimi.dsi.fastutil.ints.IntArrays;
+import net.ruthenium.Initializer;
+import org.joml.Vector3f;
+
+import java.util.Arrays;
+
+/**
+ * TEMPORARY exactness check of {@link SortOrderCache} ({@code -Druthenium.probe.sortCheck=true}): every sorted draw is
+ * also sorted with vanilla's algorithm ({@code VertexSorting.byDistance}: keys, stable merge sort by
+ * {@code Floats.compare}, descending) and compared; plus counters of how the start order was found.
+ */
+public final class SortOrderCheck {
+    public static final boolean ENABLED = Boolean.getBoolean("ruthenium.probe.sortCheck");
+
+    static long draws, quads, mismatches, entryStarts, sizeStarts, noStarts, fallbacks, sizeFallbacks, identicalCentroids, entryStartsChecked;
+    private static long uploads;
+
+    private SortOrderCheck() {
+    }
+
+    static void compare(DistanceSorting.Sorter sorter, CompactVectorArray centroids, int[] order) {
+        int size = centroids.size();
+        VertexSorting.DistanceFunction function = sorter.function();
+        Vector3f scratch = new Vector3f();
+        float[] keys = new float[size];
+        int[] indices = new int[size];
+        for (int i = 0; i < size; indices[i] = i++) {
+            keys[i] = function.apply(centroids.get(i, scratch));
+        }
+        IntArrays.mergeSort(indices, (o1, o2) -> Floats.compare(keys[o2], keys[o1]));
+
+        draws++;
+        quads += size;
+        if (!Arrays.equals(indices, order)) {
+            mismatches++;
+            if (mismatches <= 10) {
+                Initializer.LOGGER.warn("Sort order mismatch: {} quads, vanilla {} vs {}", size, Arrays.toString(indices), Arrays.toString(order));
+            }
+        }
+    }
+
+    static float[] copy(CompactVectorArray centroids) {
+        int size = centroids.size();
+        float[] copy = new float[size * 3];
+        for (int i = 0; i < size; i++) {
+            copy[3 * i] = centroids.getX(i);
+            copy[3 * i + 1] = centroids.getY(i);
+            copy[3 * i + 2] = centroids.getZ(i);
+        }
+        return copy;
+    }
+
+    static void upload() {
+        if (++uploads % 5000 == 0) {
+            Initializer.LOGGER.info("Sort order check: {} draws ({} quads) compared, {} mismatches; starts: entry {} (bit-identical centroids {} of {}), size {}, none {}; fallbacks from entries {}, from size starts {}",
+                    draws, quads, mismatches, entryStarts, identicalCentroids, entryStartsChecked, sizeStarts, noStarts, fallbacks, sizeFallbacks);
+        }
+    }
+}
