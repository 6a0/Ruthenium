@@ -0,0 +1,31 @@
+package net.ruthenium.gametest.mixin;
+
+import com.mojang.renderpearl.api.buffers.GpuBuffer;
+import com.mojang.renderpearl.backend.vulkan.DestructionQueue;
+import it.unimi.dsi.fastutil.objects.ReferenceArrayList;
+import it.unimi.dsi.fastutil.objects.ReferenceList;
+import net.ruthenium.gametest.SlowFrameProbe;
+import org.spongepowered.asm.mixin.Final;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
+
+/** s25 diagnostic: what a rotation of the Vulkan destruction queue destroys (classes, buffer bytes) */
+@Mixin(DestructionQueue.class)
+public class DestructionQueueProbeMixin<T> {
+    @Shadow @Final private ReferenceList<ReferenceArrayList<T>> destructionQueues;
+    @Shadow private int currentDestructionQueueIndex;
+
+    @Inject(method = "rotate", at = @At("HEAD"))
+    private void describe(CallbackInfoReturnable<Boolean> cir) {
+        if (!SlowFrameProbe.ENABLED || Thread.currentThread() != SlowFrameProbe.renderThread) {
+            return;
+        }
+        ReferenceArrayList<T> next = this.destructionQueues.get((this.currentDestructionQueueIndex + 1) % this.destructionQueues.size());
+        for (T t : next) {
+            SlowFrameProbe.destroyed(t.getClass(), t instanceof GpuBuffer buffer ? buffer.size() : 0L);
+        }
+    }
+}
