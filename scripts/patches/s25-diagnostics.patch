diff --git a/src/gametest/java/net/ruthenium/gametest/SlowFrameProbe.java b/src/gametest/java/net/ruthenium/gametest/SlowFrameProbe.java
new file mode 100644
index 0000000..5ca8411
--- /dev/null
+++ b/src/gametest/java/net/ruthenium/gametest/SlowFrameProbe.java
@@ -0,0 +1,124 @@
+package net.ruthenium.gametest;
+
+import java.lang.management.GarbageCollectorMXBean;
+import java.lang.management.ManagementFactory;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * s25 diagnostic: per loop iteration, the client's packet handling by packet class and the retained block entity
+ * builds, for the light profiler's slow frame dump ({@code -Pbench.slowFrameMs=N}); per phase, packet totals.
+ * Render thread only.
+ */
+public final class SlowFrameProbe {
+    public static final boolean ENABLED = LightProfiler.SLOW_FRAME_MS > 0;
+    private static final boolean HAS_MOD = net.fabricmc.loader.api.FabricLoader.getInstance().isModLoaded("ruthenium");
+    private static final List<GarbageCollectorMXBean> GC_BEANS = ManagementFactory.getGarbageCollectorMXBeans();
+    private static final Map<Class<?>, long[]> FRAME_PACKETS = new HashMap<>();
+    private static final Map<Class<?>, long[]> PHASE_PACKETS = new HashMap<>();
+    private static long frameGcs = -1;
+    private static final Map<Class<?>, long[]> FRAME_DESTROYED = new HashMap<>();
+    public static int builds;
+    public static int buildBlockEntities;
+    public static long buildNanos;
+    public static long buildMaxNanos;
+    public static int buildMaxSize;
+    public static Thread renderThread;
+
+    private SlowFrameProbe() {
+    }
+
+    public static void packet(Class<?> type, long nanos) {
+        long[] f = FRAME_PACKETS.computeIfAbsent(type, _ -> new long[2]);
+        f[0]++;
+        f[1] += nanos;
+        long[] p = PHASE_PACKETS.computeIfAbsent(type, _ -> new long[2]);
+        p[0]++;
+        p[1] += nanos;
+    }
+
+    public static void destroyed(Class<?> type, long bytes) {
+        long[] d = FRAME_DESTROYED.computeIfAbsent(type, _ -> new long[2]);
+        d[0]++;
+        d[1] += bytes;
+    }
+
+    public static void build(int blockEntities, long nanos) {
+        builds++;
+        buildBlockEntities += blockEntities;
+        buildNanos += nanos;
+        if (nanos > buildMaxNanos) {
+            buildMaxNanos = nanos;
+            buildMaxSize = blockEntities;
+        }
+    }
+
+    static String frameSummary() {
+        long[] b = HAS_MOD ? net.ruthenium.render.blockentity.RetainedBlockEntities.S25_BUILDS : new long[5];
+        builds = (int) b[0];
+        buildBlockEntities = (int) b[1];
+        buildNanos = b[2];
+        buildMaxNanos = b[3];
+        buildMaxSize = (int) b[4];
+        long gcs = gcCount();
+        StringBuilder sb = new StringBuilder();
+        sb.append("gcs +").append(frameGcs < 0 ? 0 : gcs - frameGcs);
+        sb.append(String.format(Locale.ROOT, ", retained builds %d (%d block entities, %.2f ms, max %.2f ms for %d)", builds,
+                buildBlockEntities, buildNanos / 1.0e6, buildMaxNanos / 1.0e6, buildMaxSize));
+        sb.append(", packets: ").append(top(FRAME_PACKETS, 8));
+        if (!FRAME_DESTROYED.isEmpty()) {
+            sb.append(", destroyed:");
+            FRAME_DESTROYED.forEach((type, d) -> sb.append(String.format(Locale.ROOT, " %s %d (%.1f MB)", type.getSimpleName(), d[0], d[1] / 1.0e6)));
+        }
+        return sb.toString();
+    }
+
+    static void endFrame() {
+        if (HAS_MOD) {
+            java.util.Arrays.fill(net.ruthenium.render.blockentity.RetainedBlockEntities.S25_BUILDS, 0);
+        }
+        FRAME_PACKETS.clear();
+        FRAME_DESTROYED.clear();
+        builds = 0;
+        buildBlockEntities = 0;
+        buildNanos = 0;
+        buildMaxNanos = 0;
+        buildMaxSize = 0;
+        frameGcs = gcCount();
+    }
+
+    static void resetPhase() {
+        PHASE_PACKETS.clear();
+    }
+
+    static String phaseReport() {
+        return "packets " + top(PHASE_PACKETS, 15);
+    }
+
+    private static String top(Map<Class<?>, long[]> packets, int n) {
+        List<Map.Entry<Class<?>, long[]>> entries = new ArrayList<>(packets.entrySet());
+        entries.sort((a, b) -> Long.compare(b.getValue()[1], a.getValue()[1]));
+        long total = 0, count = 0;
+        for (Map.Entry<Class<?>, long[]> e : entries) {
+            total += e.getValue()[1];
+            count += e.getValue()[0];
+        }
+        StringBuilder sb = new StringBuilder(String.format(Locale.ROOT, "%d in %.2f ms", count, total / 1.0e6));
+        for (int i = 0; i < Math.min(n, entries.size()); i++) {
+            Map.Entry<Class<?>, long[]> e = entries.get(i);
+            sb.append(String.format(Locale.ROOT, "; %s %d %.2f ms", e.getKey().getSimpleName(), e.getValue()[0], e.getValue()[1] / 1.0e6));
+        }
+        return sb.toString();
+    }
+
+    private static long gcCount() {
+        long count = 0;
+        for (GarbageCollectorMXBean bean : GC_BEANS) {
+            count += Math.max(0, bean.getCollectionCount());
+        }
+        return count;
+    }
+}
diff --git a/src/gametest/java/net/ruthenium/gametest/mixin/DestructionQueueProbeMixin.java b/src/gametest/java/net/ruthenium/gametest/mixin/DestructionQueueProbeMixin.java
