+package net.ruthenium.render.text;
+
+import net.minecraft.network.chat.Component;
+import org.slf4j.LoggerFactory;
+
+import java.util.Objects;
+
+/** Temporary check of keepDisplayNames: every kept name tag against vanilla's getNameTag (-Druthenium.nameCheck=true) */
+public final class DisplayNameCheck {
+    private static long hits, mismatches;
+
+    private DisplayNameCheck() {
+    }
+
+    public static void check(Component kept, Component vanilla) {
+        hits++;
+        if (!Objects.equals(kept, vanilla)) {
+            if (mismatches++ < 5) {
+                LoggerFactory.getLogger("Ruthenium name check").info("mismatch: kept {} vanilla {}", kept, vanilla);
+            }
+        }
+        if (hits % 1_000_000 == 0) {
+            LoggerFactory.getLogger("Ruthenium name check").info("display names: {} kept, {} mismatches", hits, mismatches);
+        }
+    }
+}
