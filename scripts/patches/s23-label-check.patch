+    /** The sorted draw's order against a fresh full sort of centroids computed with JOML's transform */
+    private static void checkOrder(LabelDraw draw, VertexSorting sorting, int[] order) {
+        CompactVectorArray centroids = new CompactVectorArray(draw.quads);
+        Vector3f scratch = new Vector3f();
+        int q = 0;
+        for (int u = 0; u < draw.uses; u++) {
+            int label = draw.useLabel[u];
+            Mesh mesh = labelMeshes[label];
+            Matrix4f pose = LABEL_POSES.get(label);
+            for (int quad = draw.useFirstQuad[u]; quad < draw.useFirstQuad[u] + draw.useQuads[u]; quad++, q++) {
+                pose.transformPosition(mesh.positions[quad * 12], mesh.positions[quad * 12 + 1], mesh.positions[quad * 12 + 2], scratch);
+                float x0 = scratch.x, y0 = scratch.y, z0 = scratch.z;
+                pose.transformPosition(mesh.positions[quad * 12 + 6], mesh.positions[quad * 12 + 7], mesh.positions[quad * 12 + 8], scratch);
+                centroids.set(q, (x0 + scratch.x) / 2.0F, (y0 + scratch.y) / 2.0F, (z0 + scratch.z) / 2.0F);
+            }
+        }
+        int[] fresh = sorting.sort(centroids);
+        LabelStats.checkedSorts++;
+        LabelStats.checkedSortQuads += fresh.length;
+        if (fresh.length != draw.quads) {
+            mismatch("sort length");
+            return;
+        }
+        for (int i = 0; i < fresh.length; i++) {
+            if (fresh[i] != order[i]) {
+                mismatch("sort order at " + i);
+                return;
+            }
+        }
+    }
