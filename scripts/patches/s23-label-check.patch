+package net.ruthenium.render.text;
+
+/** Temporary: the retained label check ({@code -Druthenium.probe.labelCheck=true}) and the non-MDI path ({@code noIndirect}) */
+public final class LabelStats {
+    public static final boolean CHECK = Boolean.getBoolean("ruthenium.probe.labelCheck");
+    /** Half the labels (by mesh identity) written as vanilla does: exercises the fallback writes and materialization */
+    public static final boolean FALLBACK = Boolean.getBoolean("ruthenium.probe.labelFallback");
+    public static final boolean NO_INDIRECT = Boolean.getBoolean("ruthenium.probe.noIndirect");
+    public static long checkedLabels, checkedVertices, checkedSorts, checkedSortQuads, mismatches;
+    private static long frames;
+
+    private LabelStats() {
+    }
+
+    public static void frame() {
+        if (CHECK && ++frames % 2000 == 0) {
+            System.out.printf("[labels] check: %d labels, %d vertices, %d sorted draws, %d sorted quads, %d mismatches%n",
+                    checkedLabels, checkedVertices, checkedSorts, checkedSortQuads, mismatches);
+        }
+    }
+}
