+    /** A fresh vanilla visit of the text with this pose and light against the mesh, its runs and the uploaded rows */
+    private static void check(SignTextCache.KeptText text, Mesh mesh, Run[] runs, Font.DisplayMode mode, Matrix4f pose, int light, boolean retained) {
+        CheckRecorder recorder = CHECK_RECORDER;
+        recorder.reset();
+        List<RenderType> types = new ArrayList<>();
+        List<Integer> ends = new ArrayList<>();
+        Matrix4f vanillaPose = new Matrix4f(pose);
+        text.visit(new Font.GlyphVisitor() {
+            @Override
+            public void acceptRenderable(TextRenderable renderable) {
+                types.add(renderable.renderType(mode));
+                renderable.render(vanillaPose, recorder, light, false);
+                ends.add(recorder.vertices / 4);
+            }
+        });
+        LabelStats.checkedLabels++;
+        if (recorder.vertices != mesh.quads * 4) {
+            mismatch("vertex count " + recorder.vertices + " vs " + mesh.quads * 4);
+            return;
+        }
+        // Runs as vanilla's per renderable draw selection sees them
+        List<Run> fresh = new ArrayList<>();
+        RenderType current = null;
+        int start = 0;
+        int quad = 0;
+        for (int i = 0; i < types.size(); i++) {
+            if (types.get(i) != current) {
+                if (current != null) {
+                    fresh.add(new Run(current, start, quad - start));
+                }
+                current = types.get(i);
+                start = quad;
+            }
+            quad = ends.get(i);
+        }
+        if (current != null) {
+            fresh.add(new Run(current, start, quad - start));
+        }
+        if (fresh.size() != runs.length) {
+            mismatch("run count " + fresh.size() + " vs " + runs.length);
+        } else {
+            for (int i = 0; i < runs.length; i++) {
+                if (fresh.get(i).renderType() != runs[i].renderType() || fresh.get(i).firstQuad() != runs[i].firstQuad() || fresh.get(i).quads() != runs[i].quads()) {
+                    mismatch("run " + i);
+                }
+            }
+        }
+        long rows = retained && poseBytes != null ? MemoryUtil.memAddress0(poseBytes) + (long) mesh.region * REGION_SIZE : 0;
+        Vector3f scratch = new Vector3f();
+        for (int v = 0; v < recorder.vertices; v++) {
+            float x = mesh.positions[v * 3], y = mesh.positions[v * 3 + 1], z = mesh.positions[v * 3 + 2];
+            float vx = recorder.positions[v * 3], vy = recorder.positions[v * 3 + 1], vz = recorder.positions[v * 3 + 2];
+            pose.transformPosition(x, y, z, scratch);
+            if (!sameBits(scratch.x, vx) || !sameBits(scratch.y, vy) || !sameBits(scratch.z, vz)) {
+                mismatch("JOML position " + v);
+            }
+            if (rows != 0) {
+                // The shader's arithmetic on the uploaded rows
+                float sx = MemoryUtil.memGetFloat(rows) * x + (MemoryUtil.memGetFloat(rows + 4) * y + (MemoryUtil.memGetFloat(rows + 8) * z + MemoryUtil.memGetFloat(rows + 12)));
+                float sy = MemoryUtil.memGetFloat(rows + 16) * x + (MemoryUtil.memGetFloat(rows + 20) * y + (MemoryUtil.memGetFloat(rows + 24) * z + MemoryUtil.memGetFloat(rows + 28)));
+                float sz = MemoryUtil.memGetFloat(rows + 32) * x + (MemoryUtil.memGetFloat(rows + 36) * y + (MemoryUtil.memGetFloat(rows + 40) * z + MemoryUtil.memGetFloat(rows + 44)));
+                if (!sameBits(sx, vx) || !sameBits(sy, vy) || !sameBits(sz, vz)) {
+                    mismatch("shader position " + v + ": " + sx + "," + sy + "," + sz + " vs " + vx + "," + vy + "," + vz);
+                }
+                int u2 = (int) MemoryUtil.memGetFloat(rows + 48), v2 = (int) MemoryUtil.memGetFloat(rows + 52);
+                if ((short) recorder.lights[v] != u2 || (short) (recorder.lights[v] >>> 16) != v2) {
+                    mismatch("light " + v);
+                }
+            }
+            if (!sameBits(mesh.uvs[v * 2], recorder.uvs[v * 2]) || !sameBits(mesh.uvs[v * 2 + 1], recorder.uvs[v * 2 + 1])) {
+                mismatch("uv " + v);
+            }
+            if (mesh.colors[v] != recorder.colors[v]) {
+                mismatch("color " + v);
+            }
+            LabelStats.checkedVertices++;
+        }
+    }
