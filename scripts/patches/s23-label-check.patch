+    // ---- Temporary exactness check (LabelStats.CHECK) ----
+    private static final CheckRecorder CHECK_RECORDER = new CheckRecorder();
+
+    private static final class CheckRecorder implements VertexConsumer {
+        float[] positions = new float[1024 * 3];
+        float[] uvs = new float[1024 * 2];
+        int[] colors = new int[1024];
+        int[] lights = new int[1024];
+        int vertices;
+
+        void reset() {
+            this.vertices = 0;
+        }
+
+        @Override
+        public VertexConsumer addVertex(float x, float y, float z) {
+            int n = this.vertices;
+            if (n == this.colors.length) {
+                this.positions = Arrays.copyOf(this.positions, n * 6);
+                this.uvs = Arrays.copyOf(this.uvs, n * 4);
+                this.colors = Arrays.copyOf(this.colors, n * 2);
+                this.lights = Arrays.copyOf(this.lights, n * 2);
+            }
+            this.positions[n * 3] = x;
+            this.positions[n * 3 + 1] = y;
+            this.positions[n * 3 + 2] = z;
+            this.vertices = n + 1;
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setColor(int r, int g, int b, int a) {
+            return this.setColor(ARGB.color(a, r, g, b));
+        }
+
+        @Override
+        public VertexConsumer setColor(int color) {
+            this.colors[this.vertices - 1] = color;
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setUv(float u, float v) {
+            this.uvs[(this.vertices - 1) * 2] = u;
+            this.uvs[(this.vertices - 1) * 2 + 1] = v;
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setUv1(int u, int v) {
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setUv2(int u, int v) {
+            this.lights[this.vertices - 1] = (u & 0xFFFF) | v << 16;
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setUv3(float u, float v) {
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setNormal(float x, float y, float z) {
+            return this;
+        }
+
+        @Override
+        public VertexConsumer setLineWidth(float width) {
+            return this;
+        }
+    }
+
+    private static boolean sameBits(float a, float b) {
+        return Float.floatToRawIntBits(a) == Float.floatToRawIntBits(b) || (a == 0.0F && b == 0.0F);
+    }
+
+    private static void mismatch(String what) {
+        LabelStats.mismatches++;
+        if (LabelStats.mismatches <= 20) {
+            System.out.println("[labels] MISMATCH " + what);
+        }
+    }
