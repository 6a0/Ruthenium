+package net.ruthenium.gametest.mixin;
+
+import com.llamalad7.mixinextras.injector.ModifyExpressionValue;
+import net.minecraft.client.Minecraft;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+
+/** S28 TEMP: {@code -Pbench.s28GlDebug=N} overrides the GL debug verbosity the device is created with */
+@Mixin(Minecraft.class)
+public class S28GlDebugMixin {
+    @ModifyExpressionValue(method = "<init>", at = @At(value = "FIELD", target = "Lnet/minecraft/client/Options;glDebugVerbosity:I"))
+    private int s28Verbosity(int original) {
+        return Integer.getInteger("ruthenium.bench.s28GlDebug", original);
+    }
+}
