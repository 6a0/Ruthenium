+package net.ruthenium.gametest.mixin;
+
+import com.mojang.renderpearl.frontend.FrontendRenderPass;
+import net.minecraft.util.profiling.Profiler;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/** S28 TEMP: counts render pass calls per profiler section ({@code -Pbench.s28Count=true}) */
+@Mixin(FrontendRenderPass.class)
+public class S28RenderPassCountMixin {
+    private static final boolean ON = Boolean.getBoolean("ruthenium.bench.s28Count");
+
+    @Inject(method = {"drawIndexed", "draw", "drawIndexedIndirect", "drawIndirect"}, at = @At("HEAD"))
+    private void s28Draw(CallbackInfo ci) {
+        if (ON) {
+            Profiler.get().incrementCounter("draw");
+        }
+    }
+
+    @Inject(method = {"multiDrawIndexed(Lorg/lwjgl/PointerBuffer;Ljava/nio/IntBuffer;Ljava/nio/IntBuffer;I)V",
+            "multiDraw(Ljava/nio/IntBuffer;Ljava/nio/IntBuffer;I)V"}, at = @At("HEAD"))
+    private void s28MultiDraw(CallbackInfo ci) {
+        if (ON) {
+            Profiler.get().incrementCounter("multiDraw");
+        }
+    }
+
+    @Inject(method = "setPipeline", at = @At("HEAD"))
+    private void s28Pipeline(CallbackInfo ci) {
+        if (ON) {
+            Profiler.get().incrementCounter("setPipeline");
+        }
+    }
+
+    @Inject(method = "setUniform(Ljava/lang/String;Ljava/lang/Object;)V", at = @At("HEAD"))
+    private void s28Uniform(CallbackInfo ci) {
+        if (ON) {
+            Profiler.get().incrementCounter("setUniform");
+        }
+    }
+
+    @Inject(method = "setVertexBuffer", at = @At("HEAD"))
+    private void s28Vertex(CallbackInfo ci) {
+        if (ON) {
+            Profiler.get().incrementCounter("setVertexBuffer");
+        }
+    }
+}
