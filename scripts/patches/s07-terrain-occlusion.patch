@@ -0,0 +1,467 @@
+package net.ruthenium.render.chunk;
+
+import net.ruthenium.Initializer;
+import org.joml.Matrix4f;
+import org.joml.Matrix4fc;
+
+import java.util.Arrays;
+
+/**
+ * Software occlusion culling of terrain sections, on the render thread while {@link TerrainDrawList} collects the
+ * frame's draws (front to back, in the order of vanilla's visible section list).
+ * <p>
+ * Each drawn section rasterizes its opaque faces ({@link SectionOccluders}) into a coverage buffer before the next
+ * sections are tested, and a section is left out when every pixel its vertex bounds could reach is covered by a
+ * face that is nearer than all of it. The faces are the section's own drawn solid quads, so a left out section is
+ * one whose fragments would all fail the depth test: no pixel changes.
+ * <p>
+ * To keep that exact, the buffer works on the GPU's samples, not on an approximation of them:
+ * <ul>
+ *     <li>The projection is the frame's own (with view bobbing and the nausea warp, {@link #setProjection}), so
+ *     the samples are the pixel centres of the main render target.</li>
+ *     <li>A tile is 8x8 samples. It keeps the depth (1/w, larger is nearer) that all its samples are known to be
+ *     covered at, plus a mask of samples covered by faces seen so far that don't cover the whole tile, with their
+ *     farthest depth. Faces that meet on a tile (the same plane in two sections, or a ledge in front of a slope)
+ *     fill it together.</li>
+ *     <li>A face covers a sample only if the sample is inside all its edges by 1/16 pixel (more than GPU vertex
+ *     snapping moves an edge), and its depth over a tile is taken at the tile's farthest sample corner.</li>
+ *     <li>Faces are clipped to w &ge; 0.1 (the near plane is at 0.05), and a section with a vertex nearer than that
+ *     is always drawn. Faces count only when the eye is 0.01 blocks in front of them, so the GPU doesn't cull them
+ *     as back faces.</li>
+ *     <li>A section is hidden only if it is behind the covering depth by a relative 1e-4.</li>
+ * </ul>
+ * Render thread only.
+ */
+public final class TerrainOcclusion {
+    private static final int TILE_SHIFT = 3;
+    private static final int TILE = 1 << TILE_SHIFT;
+    private static final double NEAR_W = 0.1;
+    private static final double EDGE_MARGIN = 1.0 / 16.0;
+    private static final double FACING_MARGIN = 0.01;
+    private static final double DEPTH_MARGIN = 1.0e-4;
+    private static final double BOUNDS_MARGIN = 0.5;
+    private static final int MAX_VERTICES = 8;
+
+    /** Faces smaller than this on screen (estimated, in pixels) are not rasterized */
+    public static float minFacePixels = Float.parseFloat(System.getProperty("ruthenium.occlusionMinPixels", "256"));
+
+    private static final Matrix4f projection = new Matrix4f();
+    private static final Matrix4f clip = new Matrix4f();
+    private static boolean projectionFresh;
+
+    /** Rows of the camera-relative position to pixel transform: x * w, y * w and w */
+    private static double xx, xy, xz, xw, yx, yy, yz, yw, wx, wy, wz, ww;
+    /** Centre of projection, camera-relative */
+    private static double eyeX, eyeY, eyeZ;
+    private static int width, height, tilesX, tilesY;
+    /** Pixels per block at distance 1 (vertically) */
+    private static double focal;
+    private static float[] full = new float[0];
+    private static float[] partialDepth = new float[0];
+    private static long[] partialMask = new long[0];
+    private static boolean active;
+
+    // Polygon scratch
+    private static final double[] px = new double[MAX_VERTICES], py = new double[MAX_VERTICES], pw = new double[MAX_VERTICES];
+    private static final double[] cx = new double[MAX_VERTICES], cy = new double[MAX_VERTICES], cw = new double[MAX_VERTICES];
+    private static final double[] edgeA = new double[MAX_VERTICES], edgeB = new double[MAX_VERTICES], edgeC = new double[MAX_VERTICES];
+
+    // Counters of the current frame, and totals over the frames culling was on (for the benchmark)
+    private static int tested, hidden, facesDrawn;
+    private static boolean counting;
+    public static long totalFrames, totalTested, totalHidden, totalFaces;
+
+    private TerrainOcclusion() {
+    }
+
+    /** The level projection of the frame being rendered, as {@code GameRenderer.renderLevel} sets it */
+    public static void setProjection(Matrix4fc matrix) {
+        projection.set(matrix);
+        projectionFresh = true;
+    }
+
+    /**
+     * Starts a frame.
+     *
+     * @param modelView the terrain's model view matrix (camera-relative positions to view space)
+     * @param width     the main render target's size in pixels
+     */
+    public static void begin(Matrix4fc modelView, int width, int height, boolean enabled) {
+        if (counting) {
+            totalFrames++;
+            totalTested += tested;
+            totalHidden += hidden;
+            totalFaces += facesDrawn;
+        }
+        tested = hidden = facesDrawn = 0;
+        counting = false;
+        active = false;
+        boolean fresh = projectionFresh;
+        projectionFresh = false;
+        if (!enabled || !fresh || !Initializer.CONFIG.terrainOcclusionCulling || width <= 0 || height <= 0) {
+            return;
+        }
+
+        Matrix4f m = projection.mul(modelView, clip);
+        double halfW = width * 0.5, halfH = height * 0.5;
+        // Clip rows (JOML is column major: mCR)
+        double rxX = m.m00(), rxY = m.m10(), rxZ = m.m20(), rxW = m.m30();
+        double ryX = m.m01(), ryY = m.m11(), ryZ = m.m21(), ryW = m.m31();
+        wx = m.m03();
+        wy = m.m13();
+        wz = m.m23();
+        ww = m.m33();
+        // Pixel x = (clip x / w * 0.5 + 0.5) * width, as the viewport maps it
+        xx = halfW * (rxX + wx);
+        xy = halfW * (rxY + wy);
+        xz = halfW * (rxZ + wz);
+        xw = halfW * (rxW + ww);
+        yx = halfH * (ryX + wx);
+        yy = halfH * (ryY + wy);
+        yz = halfH * (ryZ + wz);
+        yw = halfH * (ryW + ww);
+
+        // The eye is where clip x, y and w are all 0
+        double det = rxX * (ryY * wz - ryZ * wy) - rxY * (ryX * wz - ryZ * wx) + rxZ * (ryX * wy - ryY * wx);
+        if (Math.abs(det) < 1.0e-12) {
+            return;
+        }
+        double bx = -rxW, by = -ryW, bw = -ww;
+        eyeX = (bx * (ryY * wz - ryZ * wy) - rxY * (by * wz - ryZ * bw) + rxZ * (by * wy - ryY * bw)) / det;
+        eyeY = (rxX * (by * wz - ryZ * bw) - bx * (ryX * wz - ryZ * wx) + rxZ * (ryX * bw - by * wx)) / det;
+        eyeZ = (rxX * (ryY * bw - by * wy) - rxY * (ryX * bw - by * wx) + bx * (ryX * wy - ryY * wx)) / det;
+
+        TerrainOcclusion.width = width;
+        TerrainOcclusion.height = height;
+        focal = 0.5 * height * Math.abs(projection.m11());
+        int tx = (width + TILE - 1) >> TILE_SHIFT, ty = (height + TILE - 1) >> TILE_SHIFT;
+        if (tx * ty != full.length) {
+            full = new float[tx * ty];
+            partialDepth = new float[tx * ty];
+            partialMask = new long[tx * ty];
+        } else {
+            Arrays.fill(full, 0.0f);
+            Arrays.fill(partialMask, 0L);
+        }
+        tilesX = tx;
+        tilesY = ty;
+        active = true;
+        counting = true;
+    }
+
+    public static boolean isActive() {
+        return active;
+    }
+
+    public static void resetTotals() {
+        totalFrames = totalTested = totalHidden = totalFaces = 0;
+    }
+
+    /**
+     * @param ox the section origin relative to the camera
+     * @return false if every sample the section's vertices could reach is covered by nearer faces
+     */
+    public static boolean isVisible(SectionOccluders occluders, double ox, double oy, double oz) {
+        if (!occluders.isBounded()) {
+            return true;
+        }
+        tested++;
+        double minSx = Double.POSITIVE_INFINITY, minSy = Double.POSITIVE_INFINITY;
+        double maxSx = Double.NEGATIVE_INFINITY, maxSy = Double.NEGATIVE_INFINITY;
+        double nearest = 0.0;
+        for (int i = 0; i < 8; i++) {
+            double x = ox + ((i & 1) == 0 ? occluders.minX : occluders.maxX);
+            double y = oy + ((i & 2) == 0 ? occluders.minY : occluders.maxY);
+            double z = oz + ((i & 4) == 0 ? occluders.minZ : occluders.maxZ);
+            double w = wx * x + wy * y + wz * z + ww;
+            if (w < NEAR_W) {
+                return true;
+            }
+            double inv = 1.0 / w;
+            double sx = (xx * x + xy * y + xz * z + xw) * inv;
+            double sy = (yx * x + yy * y + yz * z + yw) * inv;
+            minSx = Math.min(minSx, sx);
+            maxSx = Math.max(maxSx, sx);
+            minSy = Math.min(minSy, sy);
+            maxSy = Math.max(maxSy, sy);
+            nearest = Math.max(nearest, inv);
+        }
+
+        // Samples (pixel centres i + 0.5) within the projected bounds
+        int i0 = Math.max(0, (int) Math.ceil(minSx - BOUNDS_MARGIN - 0.5));
+        int i1 = Math.min(width - 1, (int) Math.floor(maxSx + BOUNDS_MARGIN - 0.5));
+        int j0 = Math.max(0, (int) Math.ceil(minSy - BOUNDS_MARGIN - 0.5));
+        int j1 = Math.min(height - 1, (int) Math.floor(maxSy + BOUNDS_MARGIN - 0.5));
+        if (i0 > i1 || j0 > j1) {
+            // Off screen
+            hidden++;
+            return false;
+        }
+
+        float threshold = (float) (nearest * (1.0 + DEPTH_MARGIN));
+        float[] full = TerrainOcclusion.full;
+        int tx0 = i0 >> TILE_SHIFT, tx1 = i1 >> TILE_SHIFT;
+        for (int ty = j0 >> TILE_SHIFT, ty1 = j1 >> TILE_SHIFT; ty <= ty1; ty++) {
+            int row = ty * tilesX;
+            for (int tx = tx0; tx <= tx1; tx++) {
+                if (full[row + tx] <= threshold) {
+                    return true;
+                }
+            }
+        }
+        hidden++;
+        return false;
+    }
+
+    /** Rasterizes the faces of a section whose solid layer is drawn this frame */
+    public static void addOccluders(SectionOccluders occluders, double ox, double oy, double oz) {
+        int[] faces = occluders.faces();
+        double ex = eyeX - ox, ey = eyeY - oy, ez = eyeZ - oz;
+        // Nearest distance to the section, for the faces' largest possible size on screen
+        double dx = Math.max(0.0, Math.abs(ex - 8.0) - 8.0);
+        double dy = Math.max(0.0, Math.abs(ey - 8.0) - 8.0);
+        double dz = Math.max(0.0, Math.abs(ez - 8.0) - 8.0);
+        double distanceSquared = Math.max(1.0, dx * dx + dy * dy + dz * dz);
+        double minArea = minFacePixels * distanceSquared / (focal * focal);
+        for (int face : faces) {
+            if (SectionOccluders.area(face) < minArea) {
+                break;
+            }
+            int direction = SectionOccluders.direction(face);
+            int plane = SectionOccluders.plane(face);
+            double eye = switch (direction >> 1) {
+                case 0 -> ex;
+                case 1 -> ey;
+                default -> ez;
+            };
+            if ((direction & 1) == 0 ? eye <= plane + FACING_MARGIN : eye >= plane - FACING_MARGIN) {
+                continue;
+            }
+            int u0 = SectionOccluders.u0(face), v0 = SectionOccluders.v0(face);
+            int u1 = SectionOccluders.u1(face), v1 = SectionOccluders.v1(face);
+            switch (direction >> 1) {
+                case 0 -> {
+                    double x = ox + plane;
+                    corner(0, x, oy + u0, oz + v0);
+                    corner(1, x, oy + u1, oz + v0);
+                    corner(2, x, oy + u1, oz + v1);
+                    corner(3, x, oy + u0, oz + v1);
+                }
+                case 1 -> {
+                    double y = oy + plane;
+                    corner(0, ox + u0, y, oz + v0);
+                    corner(1, ox + u1, y, oz + v0);
+                    corner(2, ox + u1, y, oz + v1);
+                    corner(3, ox + u0, y, oz + v1);
+                }
+                default -> {
+                    double z = oz + plane;
+                    corner(0, ox + u0, oy + v0, z);
+                    corner(1, ox + u1, oy + v0, z);
+                    corner(2, ox + u1, oy + v1, z);
+                    corner(3, ox + u0, oy + v1, z);
+                }
+            }
+            facesDrawn++;
+            rasterize(4);
+        }
+    }
+
+    private static void corner(int i, double x, double y, double z) {
+        px[i] = xx * x + xy * y + xz * z + xw;
+        py[i] = yx * x + yy * y + yz * z + yw;
+        pw[i] = wx * x + wy * y + wz * z + ww;
+    }
+
+    /** Rasterizes the convex polygon in {@link #px}/{@link #py}/{@link #pw} (pixel coordinates times w, and w) */
+    private static void rasterize(int count) {
+        // Clip to w >= NEAR_W, which is linear in these coordinates
+        int n = 0;
+        for (int i = 0; i < count; i++) {
+            int j = i + 1 == count ? 0 : i + 1;
+            boolean in = pw[i] >= NEAR_W, nextIn = pw[j] >= NEAR_W;
+            if (in) {
+                cx[n] = px[i];
+                cy[n] = py[i];
+                cw[n] = pw[i];
+                n++;
+            }
+            if (in != nextIn) {
+                double t = (NEAR_W - pw[i]) / (pw[j] - pw[i]);
+                cx[n] = px[i] + (px[j] - px[i]) * t;
+                cy[n] = py[i] + (py[j] - py[i]) * t;
+                cw[n] = NEAR_W;
+                n++;
+            }
+        }
+        if (n < 3) {
+            return;
+        }
+
+        // To pixels; z is 1/w
+        double minX = Double.POSITIVE_INFINITY, minY = Double.POSITIVE_INFINITY;
+        double maxX = Double.NEGATIVE_INFINITY, maxY = Double.NEGATIVE_INFINITY;
+        for (int i = 0; i < n; i++) {
+            double inv = 1.0 / cw[i];
+            cx[i] *= inv;
+            cy[i] *= inv;
+            cw[i] = inv;
+            minX = Math.min(minX, cx[i]);
+            maxX = Math.max(maxX, cx[i]);
+            minY = Math.min(minY, cy[i]);
+            maxY = Math.max(maxY, cy[i]);
+        }
+        int i0 = Math.max(0, (int) Math.ceil(minX - 0.5)), i1 = Math.min(width - 1, (int) Math.floor(maxX - 0.5));
+        int j0 = Math.max(0, (int) Math.ceil(minY - 0.5)), j1 = Math.min(height - 1, (int) Math.floor(maxY - 0.5));
+        if (i0 > i1 || j0 > j1) {
+            return;
+        }
+
+        double area = 0.0;
+        for (int i = 0; i < n; i++) {
+            int j = i + 1 == n ? 0 : i + 1;
+            area += cx[i] * cy[j] - cx[j] * cy[i];
+        }
+        if (Math.abs(area) < 1.0e-6) {
+            return;
+        }
+        double orientation = area > 0.0 ? 1.0 : -1.0;
+        // Edge functions, positive inside, shifted inwards by the margin
+        for (int i = 0; i < n; i++) {
+            int j = i + 1 == n ? 0 : i + 1;
+            double a = -(cy[j] - cy[i]) * orientation;
+            double b = (cx[j] - cx[i]) * orientation;
+            edgeA[i] = a;
+            edgeB[i] = b;
+            edgeC[i] = -(a * cx[i] + b * cy[i]) - EDGE_MARGIN * Math.sqrt(a * a + b * b);
+        }
+
+        // Depth plane z = A x + B y + C from the triangle fan's largest triangle
+        int best = 1;
+        double bestArea = 0.0;
+        for (int k = 1; k + 1 < n; k++) {
+            double triangle = Math.abs((cx[k] - cx[0]) * (cy[k + 1] - cy[0]) - (cx[k + 1] - cx[0]) * (cy[k] - cy[0]));
+            if (triangle > bestArea) {
+                bestArea = triangle;
+                best = k;
+            }
+        }
+        double x0 = cx[0], y0 = cy[0], z0 = cw[0];
+        double dx1 = cx[best] - x0, dy1 = cy[best] - y0, dz1 = cw[best] - z0;
+        double dx2 = cx[best + 1] - x0, dy2 = cy[best + 1] - y0, dz2 = cw[best + 1] - z0;
+        double det = dx1 * dy2 - dx2 * dy1;
+        if (Math.abs(det) < 1.0e-9) {
+            return;
+        }
+        double depthA = (dz1 * dy2 - dz2 * dy1) / det;
+        double depthB = (dx1 * dz2 - dx2 * dz1) / det;
+        double depthC = z0 - depthA * x0 - depthB * y0;
+        double absA = Math.abs(depthA), absB = Math.abs(depthB);
+
+        float[] full = TerrainOcclusion.full;
+        for (int ty = j0 >> TILE_SHIFT, ty1 = j1 >> TILE_SHIFT; ty <= ty1; ty++) {
+            int sy0 = ty << TILE_SHIFT;
+            int rows = Math.min(TILE, height - sy0);
+            double hy = (rows - 1) * 0.5;
+            double centerY = sy0 + 0.5 + hy;
+            for (int tx = i0 >> TILE_SHIFT, tx1 = i1 >> TILE_SHIFT; tx <= tx1; tx++) {
+                int sx0 = tx << TILE_SHIFT;
+                int columns = Math.min(TILE, width - sx0);
+                double hx = (columns - 1) * 0.5;
+                double centerX = sx0 + 0.5 + hx;
+
+                boolean partial = false;
+                boolean outside = false;
+                for (int e = 0; e < n; e++) {
+                    double value = edgeA[e] * centerX + edgeB[e] * centerY + edgeC[e];
+                    double reach = Math.abs(edgeA[e]) * hx + Math.abs(edgeB[e]) * hy;
+                    if (value + reach < 0.0) {
+                        outside = true;
+                        break;
+                    }
+                    if (value - reach < 0.0) {
+                        partial = true;
+                    }
+                }
+                if (outside) {
+                    continue;
+                }
+
+                // Farthest depth of the face over the tile's samples
+                double depth = depthA * centerX + depthB * centerY + depthC - absA * hx - absB * hy;
+                int t = ty * tilesX + tx;
+                if (depth <= full[t]) {
+                    continue;
+                }
+                if (!partial) {
+                    full[t] = (float) depth;
+                    if (partialMask[t] != 0L && partialDepth[t] <= full[t]) {
+                        partialMask[t] = 0L;
+                    }
+                    continue;
+                }
+
+                long mask = coverage(n, sx0 + 0.5, sy0 + 0.5, columns, rows);
+                if (mask == 0L) {
+                    continue;
+                }
+                long previous = partialMask[t];
+                float merged = (float) depth;
+                if (previous != 0L) {
+                    mask |= previous;
+                    merged = Math.min(merged, partialDepth[t]);
+                }
+                if (mask == validMask(columns, rows)) {
+                    if (merged > full[t]) {
+                        full[t] = merged;
+                    }
+                    partialMask[t] = 0L;
+                } else if (merged > full[t]) {
+                    partialMask[t] = mask;
+                    partialDepth[t] = merged;
+                } else {
+                    partialMask[t] = 0L;
+                }
+            }
+        }
+    }
+
+    /** The tile's samples inside all edges: bit {@code row * 8 + column} */
+    private static long coverage(int edges, double x0, double y0, int columns, int rows) {
+        long mask = 0L;
+        for (int r = 0; r < rows; r++) {
+            double y = y0 + r;
+            double lo = 0.0, hi = columns - 1;
+            for (int e = 0; e < edges && lo <= hi; e++) {
+                // Inside where a * column + k >= 0
+                double a = edgeA[e];
+                double k = a * x0 + edgeB[e] * y + edgeC[e];
+                if (a > 1.0e-12) {
+                    lo = Math.max(lo, Math.ceil(-k / a));
+                } else if (a < -1.0e-12) {
+                    hi = Math.min(hi, Math.floor(k / -a));
+                } else if (k < 0.0) {
+                    hi = -1.0;
+                }
+            }
+            if (lo <= hi) {
+                int first = (int) lo, last = (int) hi;
+                long bits = (1L << (last - first + 1)) - 1L;
+                mask |= bits << first << (r << TILE_SHIFT);
+            }
+        }
+        return mask;
+    }
+
+    private static long validMask(int columns, int rows) {
+        if (columns == TILE && rows == TILE) {
+            return -1L;
+        }
+        long row = (1L << columns) - 1L;
+        long mask = 0L;
+        for (int r = 0; r < rows; r++) {
+            mask |= row << (r << TILE_SHIFT);
+        }
+        return mask;
+    }
+}
