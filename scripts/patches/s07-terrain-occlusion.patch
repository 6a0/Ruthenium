+package net.ruthenium.render.chunk;
+
+import com.mojang.blaze3d.vertex.DefaultVertexFormat;
+import com.mojang.blaze3d.vertex.MeshData;
+import com.mojang.renderpearl.api.pipeline.PrimitiveTopology;
+import net.minecraft.client.renderer.chunk.ChunkSectionLayer;
+import org.lwjgl.system.MemoryUtil;
+
+import java.nio.ByteBuffer;
+import java.util.Arrays;
+
+/**
+ * What {@link TerrainOcclusion} needs of a compiled section: the bounds of all its vertices, and the opaque faces it
+ * draws, as rectangles.
+ * <p>
+ * The faces are the solid layer's quads that are a whole block face (a unit square on the block grid in an
+ * axis-aligned plane), merged per plane and facing into rectangles. They are taken from the mesh itself, so they are
+ * exactly what the GPU draws for the section: opaque (the solid layer neither blends nor discards), facing the way of
+ * their winding, and adjacent quads share their vertices, so a rectangle has no cracks.
+ * <p>
+ * Built on the compile worker of the section, read on the render thread once the mesh is published.
+ */
+public final class SectionOccluders {
+    /** Positive x, negative x, positive y, ... */
+    public static final int DIRECTIONS = 6;
+    private static final int PLANES = 17;
+
+    private static final ThreadLocal<short[]> ROWS = ThreadLocal.withInitial(() -> new short[DIRECTIONS * PLANES * 16]);
+    private static final int[] NO_FACES = new int[0];
+
+    /**
+     * Per rectangle, largest first: direction (3 bits), plane (5 bits), then the first and last block of its two
+     * in-plane axes (4 bits each). The in-plane axes are y and z for faces along x, x and z along y, and x and y
+     * along z.
+     */
+    int[] faces = NO_FACES;
+    /** Section-relative bounds of the vertices; empty (min > max) until a layer is added */
+    float minX = Float.POSITIVE_INFINITY, minY = Float.POSITIVE_INFINITY, minZ = Float.POSITIVE_INFINITY;
+    float maxX = Float.NEGATIVE_INFINITY, maxY = Float.NEGATIVE_INFINITY, maxZ = Float.NEGATIVE_INFINITY;
+    /** False if a layer's vertices couldn't be read; the section is then never treated as hidden */
+    boolean bounded = true;
+
+    public static int direction(int face) {
+        return face & 7;
+    }
+
+    public static int plane(int face) {
+        return face >>> 3 & 31;
+    }
+
+    public static int u0(int face) {
+        return face >>> 8 & 15;
+    }
+
+    public static int v0(int face) {
+        return face >>> 12 & 15;
+    }
+
+    /** Exclusive end */
+    public static int u1(int face) {
+        return (face >>> 16 & 15) + 1;
+    }
+
+    /** Exclusive end */
+    public static int v1(int face) {
+        return (face >>> 20 & 15) + 1;
+    }
+
+    /** In blocks */
+    public static int area(int face) {
+        return (u1(face) - u0(face)) * (v1(face) - v0(face));
+    }
+
+    public int[] faces() {
+        return this.faces;
+    }
+
+    public boolean isBounded() {
+        return this.bounded && this.minX <= this.maxX;
+    }
+
+    /** Adds a layer mesh of the section as the compiler finishes it */
+    public void addLayer(ChunkSectionLayer layer, MeshData mesh) {
+        MeshData.DrawState state = mesh.drawState();
+        boolean compressed = state.format() == CompressedTerrain.FORMAT;
+        if (state.format() != DefaultVertexFormat.BLOCK && !compressed) {
+            this.bounded = false;
+            return;
+        }
+        int stride = state.format().getVertexSize();
+        int vertexCount = state.vertexCount();
+        ByteBuffer vertices = mesh.vertexBuffer();
+        if (vertices.remaining() < vertexCount * stride) {
+            this.bounded = false;
+            return;
+        }
+        long base = MemoryUtil.memAddress(vertices);
+
+        float minX = this.minX, minY = this.minY, minZ = this.minZ;
+        float maxX = this.maxX, maxY = this.maxY, maxZ = this.maxZ;
+        float[] position = new float[12];
+        for (int v = 0; v < vertexCount; v += 4) {
+            int count = Math.min(4, vertexCount - v);
+            SectionFaceGroups.readPositions(base + (long) v * stride, stride, compressed, position, count);
+            for (int i = 0; i < count * 3; i += 3) {
+                minX = Math.min(minX, position[i]);
+                maxX = Math.max(maxX, position[i]);
+                minY = Math.min(minY, position[i + 1]);
+                maxY = Math.max(maxY, position[i + 1]);
+                minZ = Math.min(minZ, position[i + 2]);
+                maxZ = Math.max(maxZ, position[i + 2]);
+            }
+        }
+        this.minX = minX;
+        this.minY = minY;
+        this.minZ = minZ;
+        this.maxX = maxX;
+        this.maxY = maxY;
+        this.maxZ = maxZ;
+
+        if (layer == ChunkSectionLayer.SOLID && mesh.indexBuffer() == null && state.primitiveTopology() == PrimitiveTopology.QUADS) {
+            this.faces = findFaces(base, stride, compressed, vertexCount / 4, position);
+        }
+    }
+
+    private static int[] findFaces(long base, int stride, boolean compressed, int quadCount, float[] position) {
+        short[] rows = ROWS.get();
+        Arrays.fill(rows, (short) 0);
+        int found = 0;
+        for (int q = 0; q < quadCount; q++) {
+            SectionFaceGroups.readPositions(base + (long) q * 4 * stride, stride, compressed, position, 4);
+            int face = unitFace(position);
+            if (face >= 0) {
+                rows[face >>> 4] |= (short) (1 << (face & 15));
+                found++;
+            }
+        }
+        return found == 0 ? NO_FACES : merge(rows);
+    }
+
+    /**
+     * @return {@code ((direction * PLANES + plane) * 16 + v) * 16 + u} of a quad that covers exactly one block face,
+     * or -1
+     */
+    private static int unitFace(float[] p) {
+        // Normal of the quad's winding from its diagonals, like SectionFaceGroups
+        float ax = p[6] - p[0], ay = p[7] - p[1], az = p[8] - p[2];
+        float bx = p[9] - p[3], by = p[10] - p[4], bz = p[11] - p[5];
+        float nx = ay * bz - az * by;
+        float ny = az * bx - ax * bz;
+        float nz = ax * by - ay * bx;
+
+        int axis, u, v;
+        float normal;
+        if (p[0] == p[3] && p[0] == p[6] && p[0] == p[9]) {
+            axis = 0;
+            u = 1;
+            v = 2;
+            normal = nx;
+        } else if (p[1] == p[4] && p[1] == p[7] && p[1] == p[10]) {
+            axis = 1;
+            u = 0;
+            v = 2;
+            normal = ny;
+        } else if (p[2] == p[5] && p[2] == p[8] && p[2] == p[11]) {
+            axis = 2;
+            u = 0;
+            v = 1;
+            normal = nz;
+        } else {
+            return -1;
+        }
+        if (normal == 0.0f) {
+            return -1;
+        }
+
+        float plane = p[axis];
+        float u0 = Math.min(Math.min(p[u], p[u + 3]), Math.min(p[u + 6], p[u + 9]));
+        float v0 = Math.min(Math.min(p[v], p[v + 3]), Math.min(p[v + 6], p[v + 9]));
+        if (plane != (int) plane || plane < 0.0f || plane > 16.0f || u0 != (int) u0 || u0 < 0.0f || u0 > 15.0f
+                || v0 != (int) v0 || v0 < 0.0f || v0 > 15.0f) {
+            return -1;
+        }
+        // The 4 vertices must be the 4 corners of the unit square
+        int corners = 0;
+        for (int i = 0; i < 12; i += 3) {
+            float du = p[i + u] - u0, dv = p[i + v] - v0;
+            if (du != 0.0f && du != 1.0f || dv != 0.0f && dv != 1.0f) {
+                return -1;
+            }
+            corners |= 1 << ((int) du | (int) dv << 1);
+        }
+        if (corners != 15) {
+            return -1;
+        }
+        int direction = axis * 2 + (normal > 0.0f ? 0 : 1);
+        return ((direction * PLANES + (int) plane) * 16 + (int) v0) * 16 + (int) u0;
+    }
+
+    /** Greedy merge of each plane's unit faces into rectangles */
+    private static int[] merge(short[] rows) {
+        int[] faces = new int[32];
+        int count = 0;
+        for (int dp = 0; dp < DIRECTIONS * PLANES; dp++) {
+            int rowBase = dp * 16;
+            for (int v = 0; v < 16; v++) {
+                int row;
+                while ((row = rows[rowBase + v] & 0xFFFF) != 0) {
+                    int u0 = Integer.numberOfTrailingZeros(row);
+                    int u1 = u0 + Integer.numberOfTrailingZeros(~(row >>> u0));
+                    int run = ((1 << (u1 - u0)) - 1) << u0;
+                    int v1 = v + 1;
+                    while (v1 < 16 && (rows[rowBase + v1] & run) == run) {
+                        v1++;
+                    }
+                    for (int r = v; r < v1; r++) {
+                        rows[rowBase + r] &= (short) ~run;
+                    }
+                    if (count == faces.length) {
+                        faces = Arrays.copyOf(faces, count * 2);
+                    }
+                    int direction = dp / PLANES, plane = dp % PLANES;
+                    faces[count++] = direction | plane << 3 | u0 << 8 | v << 12 | (u1 - 1) << 16 | (v1 - 1) << 20;
+                }
+            }
+        }
+        // Largest first (stable), so a frame can stop at the first face too small to matter
+        Integer[] order = new Integer[count];
+        for (int i = 0; i < count; i++) {
+            order[i] = faces[i];
+        }
+        Arrays.sort(order, (a, b) -> Integer.compare(area(b), area(a)));
+        int[] sorted = new int[count];
+        for (int i = 0; i < count; i++) {
+            sorted[i] = order[i];
+        }
+        return sorted;
+    }
+}
