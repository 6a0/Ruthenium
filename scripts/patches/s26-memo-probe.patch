+package net.ruthenium.render;
+
+import net.minecraft.client.renderer.rendertype.RenderTypes;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import java.util.ArrayList;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Temporary probe (s26, not committed): Util.memoize lookups on the render thread per frame, by memo instance */
+public final class MemoProbe {
+    public static final boolean ENABLED = Boolean.getBoolean("ruthenium.probe.memo");
+    private static final Logger LOGGER = LoggerFactory.getLogger("Ruthenium memo probe");
+    private static final Map<Object, Stat> STATS = new IdentityHashMap<>();
+    private static Thread renderThread;
+    private static int frames;
+
+    private static final class Stat {
+        long calls;
+        long lastHits;
+        long equalHits;
+        Object lastA;
+        Object lastB;
+        final Map<Object, Boolean> keys = new IdentityHashMap<>();
+        final java.util.HashSet<Object> equalKeys = new java.util.HashSet<>();
+        String caller;
+    }
+
+    private MemoProbe() {
+    }
+
+    public static void call(Object memo, Object a, Object b) {
+        Thread t = Thread.currentThread();
+        if (renderThread == null || t != renderThread) {
+            return;
+        }
+        Stat s = STATS.get(memo);
+        if (s == null) {
+            s = new Stat();
+            s.caller = StackWalker.getInstance().walk(st -> st.skip(3).limit(3)
+                    .map(f -> f.getClassName().substring(f.getClassName().lastIndexOf('.') + 1) + "." + f.getMethodName())
+                    .reduce((x, y) -> x + " < " + y).orElse("?"));
+            STATS.put(memo, s);
+        }
+        s.calls++;
+        if (a == s.lastA && b == s.lastB) {
+            s.lastHits++;
+        }
+        s.lastA = a;
+        s.lastB = b;
+        if (s.keys.size() < 4096) {
+            s.keys.put(a, Boolean.TRUE);
+        }
+        if (s.equalKeys.size() < 4096) {
+            s.equalKeys.add(a);
+        }
+    }
+
+    /** Called once per frame on the render thread */
+    public static void frame() {
+        if (!ENABLED) {
+            return;
+        }
+        renderThread = Thread.currentThread();
+        if (++frames % 5000 != 0) {
+            return;
+        }
+        Map<Object, String> names = new IdentityHashMap<>();
+        for (Field f : RenderTypes.class.getDeclaredFields()) {
+            if (Modifier.isStatic(f.getModifiers()) && !f.getType().isPrimitive()) {
+                try {
+                    f.setAccessible(true);
+                    Object v = f.get(null);
+                    if (v != null) {
+                        names.put(v, "RenderTypes." + f.getName());
+                    }
+                } catch (Throwable ignored) {
+                }
+            }
+        }
+        List<Map.Entry<Object, Stat>> list = new ArrayList<>(STATS.entrySet());
+        list.sort((x, y) -> Long.compare(y.getValue().calls, x.getValue().calls));
+        StringBuilder sb = new StringBuilder("memo lookups per frame over " + frames + " frames:");
+        for (Map.Entry<Object, Stat> e : list) {
+            Stat s = e.getValue();
+            sb.append(String.format("%n  %8.2f/frame  last-hit %5.1f%%  keys %d (equal %d)  %s  first caller %s",
+                    s.calls / (double) frames, 100.0 * s.lastHits / Math.max(1, s.calls), s.keys.size(), s.equalKeys.size(),
+                    names.getOrDefault(e.getKey(), e.getKey().getClass().getSimpleName()), s.caller));
+        }
+        LOGGER.info(sb.toString());
+    }
+}
