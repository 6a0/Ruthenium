@@ -0,0 +1,15 @@
+package net.ruthenium.interfaces;
+
+import org.jspecify.annotations.Nullable;
+
+/**
+ * The alpha of the pixels a downloaded {@link net.minecraft.client.renderer.texture.DynamicTexture} (player skins, capes,
+ * elytra) last uploaded to the GPU, for {@link net.ruthenium.render.entity.TransparentFaces}. Render thread only.
+ */
+public interface UploadedAlpha {
+    /** Starts keeping the alpha of every upload, beginning with the pixels uploaded so far (the texture's constructor) */
+    void ruthenium$keepUploadedAlpha();
+
+    /** One byte per texel, row by row, of the last upload; null if not kept. Never changed once handed out. */
+    byte @Nullable [] ruthenium$uploadedAlpha();
+}
