@@ -0,0 +1,27 @@
+package net.ruthenium.mixin.render.entity;
+
+import net.minecraft.client.renderer.texture.AbstractTexture;
+import net.minecraft.client.renderer.texture.SkinTextureDownloader;
+import net.ruthenium.interfaces.UploadedAlpha;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.ModifyArg;
+
+/**
+ * Downloaded skins, capes and elytra keep the alpha of what they uploaded ({@link UploadedAlpha}), so that
+ * {@link net.ruthenium.render.entity.TransparentFaces} can test them. The texture is registered right after its
+ * constructor uploaded the processed image (legacy skins converted, the base layer made opaque), so the pixels it
+ * holds then are the GPU's. Optional: if the lambda is not found, downloaded textures are just not tested.
+ */
+@Mixin(SkinTextureDownloader.class)
+public class SkinTextureDownloaderM {
+    @ModifyArg(method = "lambda$registerTextureInManager$0", require = 0, at = @At(value = "INVOKE",
+            target = "Lnet/minecraft/client/renderer/texture/TextureManager;register(Lnet/minecraft/resources/Identifier;Lnet/minecraft/client/renderer/texture/AbstractTexture;)V"),
+            index = 1)
+    private AbstractTexture ruthenium$keepAlpha(AbstractTexture texture) {
+        if (texture instanceof UploadedAlpha uploaded) {
+            uploaded.ruthenium$keepUploadedAlpha();
+        }
+        return texture;
+    }
+}
