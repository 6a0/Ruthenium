@@ -0,0 +1,61 @@
+package net.ruthenium.mixin.render.entity;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import net.minecraft.client.renderer.texture.DynamicTexture;
+import net.ruthenium.interfaces.UploadedAlpha;
+import org.jspecify.annotations.Nullable;
+import org.spongepowered.asm.mixin.Mixin;
+import org.spongepowered.asm.mixin.Shadow;
+import org.spongepowered.asm.mixin.Unique;
+import org.spongepowered.asm.mixin.injection.At;
+import org.spongepowered.asm.mixin.injection.Inject;
+import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;
+
+/**
+ * Keeps the alpha of what a downloaded texture uploaded ({@link UploadedAlpha}). A copy is taken right after each
+ * {@code upload()}, so it is what the GPU holds whatever is later done to the {@link NativeImage}: edits and
+ * {@code setPixels} change nothing on the GPU until the next upload, which takes a new copy.
+ */
+@Mixin(DynamicTexture.class)
+public class DynamicTextureM implements UploadedAlpha {
+    @Shadow private NativeImage pixels;
+
+    @Unique private boolean ruthenium$keepAlpha;
+    @Unique private byte @Nullable [] ruthenium$alpha;
+
+    @Inject(method = "upload", at = @At("RETURN"))
+    private void ruthenium$copyAlpha(CallbackInfo ci) {
+        if (this.ruthenium$keepAlpha) {
+            this.ruthenium$alpha = this.ruthenium$readAlpha();
+        }
+    }
+
+    @Override
+    public void ruthenium$keepUploadedAlpha() {
+        if (!this.ruthenium$keepAlpha) {
+            this.ruthenium$keepAlpha = true;
+            this.ruthenium$alpha = this.ruthenium$readAlpha();
+        }
+    }
+
+    @Override
+    public byte @Nullable [] ruthenium$uploadedAlpha() {
+        return this.ruthenium$alpha;
+    }
+
+    @Unique
+    private byte @Nullable [] ruthenium$readAlpha() {
+        NativeImage image = this.pixels;
+        if (image == null || image.isClosed() || image.format() != NativeImage.Format.RGBA) {
+            return null;
+        }
+        int width = image.getWidth(), height = image.getHeight();
+        byte[] alpha = new byte[width * height];
+        for (int y = 0; y < height; y++) {
+            for (int x = 0; x < width; x++) {
+                alpha[y * width + x] = (byte) (image.getPixel(x, y) >>> 24);
+            }
+        }
+        return alpha;
+    }
+}
