{
  "schemaVersion": 1,
  "id": "ruthenium",
  "version": "${version}",

  "name": "Ruthenium",
  "description": "An all-in-one tweak designed to run as efficiently as possible: lower RAM usage, faster loading, bug fixes, and higher, more consistent frame rates with lower latency in every scenario.",
  "authors": [
    "Collateral"
  ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/6a0/VulkanMod"
  },

  "icon": "assets/ruthenium/vlogo.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.ruthenium.Initializer"
    ]
  },
  "mixins": [
    "ruthenium.mixins.json"
  ],
  "accessWidener" : "ruthenium.accesswidener",

  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
